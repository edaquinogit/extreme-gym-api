# Gateway identification
GATEWAY_ID=extreme-gym-gateway
GATEWAY_NAME=Gateway Local Extreme Gym
GATEWAY_VERSION=0.1.0

# Backend connectivity
BACKEND_BASE_URL=https://example-backend.local
DEVICE_ID=device-1234
DEVICE_API_KEY=replace-with-device-api-key
DEVICE_HMAC_SECRET=replace-with-hmac-secret
ADMIN_API_KEY=replace-with-admin-api-key

# Local gateway runtime
GATEWAY_PORT=4000
GATEWAY_DATA_PATH=./gateway.sqlite
SNAPSHOT_REFRESH_INTERVAL_SECONDS=300
SNAPSHOT_TTL_SECONDS=900
OFFLINE_MODE_ENABLED=true
OFFLINE_STRICT_MODE=true
SYNC_INTERVAL_SECONDS=60
SYNC_BATCH_SIZE=50
LOG_LEVEL=info

# Optional local-only development
NODE_ENV=development
