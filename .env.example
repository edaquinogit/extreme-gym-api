# Copie para .env para uso local com Docker Compose.
# Nao use estes valores em producao.

SPRING_PROFILES_ACTIVE=dev
SKIP_TESTS=true

POSTGRES_DB=extreme_db
POSTGRES_USER=extreme_user
POSTGRES_PASSWORD=change-me-local-only

# Usado diretamente pelo profile prod e documentado para deploy.
DATABASE_URL=jdbc:postgresql://postgres:5432/extreme_db
DATABASE_USERNAME=extreme_user
DATABASE_PASSWORD=change-me-local-only

# Gere outro valor para qualquer ambiente compartilhado:
# openssl rand -base64 32
JWT_SECRET=replace-with-openssl-rand-base64-32

# Registro publico deve ficar desabilitado por padrao.
AUTH_REGISTRATION_ENABLED=false

# Frontend oficial fica em outro repositorio:
# https://github.com/edaquinogit/extreme-gym-web.git
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Credencial admin inicial apenas para desenvolvimento local.
ADMIN_EMAIL=admin@extremegym.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-local-admin-password
