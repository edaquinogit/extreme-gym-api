# Copie para .env para uso local com Docker Compose.
# Nao use estes valores em producao.

SPRING_PROFILES_ACTIVE=dev

POSTGRES_DB=extreme_db
POSTGRES_USER=extreme_user
POSTGRES_PASSWORD=extreme_pass_local_only

# Gere outro valor para qualquer ambiente compartilhado:
# openssl rand -base64 32
JWT_SECRET=dev-compose-MzA3NDAzNTkwNzcwOTMzMDgyODI5NjM4NzYwNzA4Ng==

# Registro publico deve ficar desabilitado por padrao.
AUTH_REGISTRATION_ENABLED=false

# Credencial admin inicial apenas para desenvolvimento local.
ADMIN_EMAIL=admin@extremegym.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123DevLocalOnly!
